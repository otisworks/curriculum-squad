# Copy this file to ".env" and fill in the key for whichever service you use.
# Then you never have to type "export" again - just run the tool.
#
#   cp .env.example .env
#
# Keep .env private: it holds a key that can spend money. It is already listed
# in .gitignore so it won't be committed by accident.

# ---------------------------------------------------------------
# 1. Your API key - you only need ONE of these
# ---------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPENAI_API_KEY=sk-your-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here
# DEEPSEEK_API_KEY=your-key-here

# ---------------------------------------------------------------
# 2. Which service to use (optional)
# ---------------------------------------------------------------
# Defaults to anthropic. Must match the key you filled in above.
# Options: anthropic | openai | openrouter | deepseek
#
# Note: deepseek cannot search the web, so it cannot check whether the books
# it recommends actually exist. Fine for a rough draft, not for a real proposal.

# LLM_PROVIDER=anthropic

# ---------------------------------------------------------------
# 3. Model choice (optional)
# ---------------------------------------------------------------
# Leave these alone unless you have a reason to change them.

# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.6-terra
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
# DEEPSEEK_MODEL=deepseek-v4-pro
